// Speed-run tool set: search (SearXNG) + fetch, no tool_search indirection.
// Applied with: ./oc config patch --stdin < tools.patch.json5
{ tools: { allow: ["web_search", "web_fetch"], toolSearch: false, codeMode: null,
           web: { search: { provider: "searxng" } } },
  plugins: { entries: { searxng: { enabled: true, config: { webSearch: { baseUrl: "http://searxng:8080" } } } } } }
